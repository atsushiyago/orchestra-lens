{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "react-native": [
        "./node_modules/@amazon-devices/react-native-kepler"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "tools"
  ]
}
